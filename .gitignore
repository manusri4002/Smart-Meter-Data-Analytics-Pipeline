# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Packaging
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# Generated pipeline data (regenerable via `python main.py`)
data/raw/*.csv
data/processed/*.csv

# Saved model artifacts (regenerable via `python main.py`)
# NOTE: segmentation.py / anomaly.py both default model_dir="models" (plural).
# This previously said "model/*.pkl" / "model/*.joblib" (singular), which
# never matched the actual output directory, so trained .joblib files were
# NOT being ignored.
models/*.pkl
models/*.joblib

# Logs
*.log
